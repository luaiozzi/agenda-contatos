# Opcional. Copie este arquivo para ".env" (que NÃO vai para o git) e ajuste os valores.
# O docker compose lê o .env automaticamente. Sem ele, valores de desenvolvimento são usados.

# Segredo usado para assinar os tokens JWT (mínimo de 32 caracteres).
JWT_KEY=troque-esta-chave-por-um-segredo-longo-com-no-minimo-32-caracteres

# Usuário criado automaticamente na primeira execução.
ADMIN_EMAIL=admin@agenda.com
ADMIN_PASSWORD=Admin@123
